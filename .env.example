# ─── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by API routes (Telegram intake, AI search) to bypass RLS.
# NEVER expose this to the client / commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single owner of this private instance (your auth.users UUID).
# Server routes attribute captured items to this user.
OPENLOOP_OWNER_ID=your-auth-user-uuid

# ─── AI search ───────────────────────────────────────────────────────────────
# Shared secret required in the `x-openloop-key` header to call /api/ai/*.
AI_SEARCH_API_KEY=generate-a-long-random-string

# ─── Telegram (optional capture channel) ─────────────────────────────────────
# Create a bot via @BotFather, then set the webhook to:
#   https://<your-app>/api/telegram/webhook?secret=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
# Only accept messages from this Telegram numeric user id (your own).
TELEGRAM_ALLOWED_USER_ID=
